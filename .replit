modules = ["nodejs-20", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dev-server"

[[workflows.workflow]]
name = "dev-server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/standalone.ts & sleep 3 && npx vite --host 0.0.0.0 --port 5000 --strictPort"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
ADMIN_EMAIL = "famechase.com@gmail.com"
ADMIN_PASSWORD = "Jackyu@62"
JWT_SECRET = "famechase-jwt-secret-2025-secure-key"
API_PORT = "3001"

[deployment]
deploymentTarget = "autoscale"
run = ["npx", "tsx", "server/production.ts"]
build = ["npm", "run", "build"]
